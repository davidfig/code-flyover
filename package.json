{
  "name": "code-flyover",
  "version": "1.0.0",
  "description": "Code review on a map: see where a change lands in the architecture, then zoom in.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "analyze": "tsx analyzer/cli.ts",
    "app": "node bin/flyover.mjs",
    "changelog:site": "tsx scripts/changelog-page.ts",
    "deploy:site": "npm run changelog:site && cf deploy ./site"
  },
  "license": "MIT",
  "repository": "github:davidfig/code-flyover",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "cf": "^1.0.0-rc.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.8"
  },
  "private": true,
  "bin": {
    "flyover": "bin/flyover.mjs"
  },
  "dependencies": {
    "@shikijs/engine-oniguruma": "^4.6.0",
    "@shikijs/langs": "^4.6.0",
    "@shikijs/primitive": "^4.6.0"
  }
}
