{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Code Flyover",
  "version": "0.1.7",
  "identifier": "app.code-flyover.desktop",
  "build": {
    "frontendDist": "loading"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Code Flyover", "width": 1440, "height": 900, "minWidth": 720, "minHeight": 480, "titleBarStyle": "Overlay", "hiddenTitle": true, "dragDropEnabled": false, "backgroundThrottling": "disabled" }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": {
      "deb": { "depends": ["nodejs", "git"] },
      "rpm": { "depends": ["nodejs", "git"] }
    }
  }
}
