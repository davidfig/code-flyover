{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Semantic Zoom",
  "version": "0.1.0",
  "identifier": "app.semantic-zoom.desktop",
  "build": {
    "frontendDist": "loading"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Semantic Zoom", "width": 1440, "height": 900, "minWidth": 720, "minHeight": 480, "titleBarStyle": "Overlay", "hiddenTitle": true, "dragDropEnabled": false, "backgroundThrottling": "disabled" }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
